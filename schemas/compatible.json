{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "features": {
            "type": "string"
          },
          "supports": {
            "anyOf": [
              {
                "type": "boolean",
                "const": true
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": ["url"],
                  "additionalProperties": false
                }
              }
            ]
          }
        },
        "required": ["url"],
        "additionalProperties": false
      }
    }
  },
  "required": ["mods"],
  "additionalProperties": false
}
