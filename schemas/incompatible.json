{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["url", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["mods"],
  "additionalProperties": false
}
