---
import PaginationControls from "@/components/PaginationControls.astro";
import type { ModCompat } from "@/mods";
import type { Page } from "@/pagination";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

export type Props = Page<ModCompat> & {
  component: AstroComponentFactory;
};

const { pagination, values, component: Component } = Astro.props;
---

<section id="mods">
  <PaginationControls {...pagination} id="top-pagination" />

  <ul>
    {values.map((it) => <Component {...it} />)}
  </ul>

  <PaginationControls {...pagination} scroll id="bottom-pagination" />
</section>

<style scoped>
  ul {
    list-style: none;

    width: 800px;
    max-width: 90dvw;

    display: grid;
    gap: 1em;
    padding: 0;
  }
</style>
