---
import ModCard from "../components/ModCard.astro";
import type { ModCompat } from "../mods";
import type { Page } from "../pagination";
import type { WithMatches } from "../search";
import PaginationControls from "./PaginationControls.astro";

export type Props = Page<WithMatches<ModCompat>>;

const { values, pagination } = Astro.props;
---

<section id="mods">
  <PaginationControls {...pagination} id="top-pagination" />

  <ul>
    {values.map((it) => <ModCard {...it} />)}
  </ul>

  <PaginationControls {...pagination} scroll id="bottom-pagination" />
</section>

<style scoped>
  ul {
    list-style: none;

    width: 800px;
    max-width: 90dvw;

    display: grid;
    gap: 1em;
    padding: 0;
  }
</style>
