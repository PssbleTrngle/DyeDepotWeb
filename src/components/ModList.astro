---
import type { ConnectionType } from "../components/ModCard.astro";
import ModCard from "../components/ModCard.astro";
import type { ModCompat } from "../mods";
import type { WithMatches } from "../search";

export type Props = {
  mods: WithMatches<ModCompat>[];
  connectionType: ConnectionType;
};

const { mods, connectionType } = Astro.props;
---

<ul id="mods">
  {mods.map((it) => <ModCard {...it} connectionType={connectionType} />)}
</ul>

<style scoped>
  ul {
    list-style: none;

    width: 800px;
    max-width: 90dvw;

    display: grid;
    gap: 1em;
  }
</style>
