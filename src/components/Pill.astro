---
import type { Loader } from "@/loaders";

const colors: Record<Loader, string | undefined> = {
  neoforge: "#f99e6b",
  forge: "#959eef",
  fabric: "#dbb69b",
};

export type Props = { text: string };

const { text } = Astro.props;
---

<span style={{ color: colors[text as Loader] }}>
  {text}
</span>

<style scoped>
  span {
    background: var(--bg-1);
    padding: 0.3em 0.6em;
    align-self: center;
    border-radius: 9999px;
  }
</style>
