---
import ModIcon from "@/components/ModIcon.astro";
import Pill from "@/components/Pill.astro";
import type { ModCompat } from "@/mods";
import type { WithMatches } from "@/search";
import { Icon } from "astro-icon/components";

export type Props = WithMatches<ModCompat>;

const { mod, connections, description, matches = [] } = Astro.props;

const highlightedMods = matches
  .filter((it) => it.key?.startsWith("connections."))
  .map((it) => it.refIndex ?? -1);
---

<li class="card" id={`mod-${mod.slug}`}>
  <a class="icon" href={mod.url}>
    <ModIcon url={mod.iconUrl} />
  </a>

  <h3>
    <span>{mod.name}</span>
    {
      mod.links.source && (
        <a href={mod.links.source} title="source code">
          <Icon name="simple-icons:git" />
        </a>
      )
    }
    {
      mod.links.modrinth && (
        <a href={mod.links.modrinth} title="modrinth project">
          <Icon name="simple-icons:modrinth" />
        </a>
      )
    }
    {
      mod.links.curseforge && (
        <a href={mod.links.curseforge} title="curseforge project">
          <Icon name="simple-icons:curseforge" />
        </a>
      )
    }
  </h3>

  <section class="pills">
    {mod.minecraftVersions.map((it) => <Pill text={it} />)}
    {mod.loaders.map((it) => <Pill text={it} />)}
  </section>

  <section class="details">
    {description && <p class="description">{description}</p>}
    <slot name="details" />
    {
      connections.length > 0 && (
        <ul class="connections">
          {connections.map((it, i) => (
            <li title={it.name}>
              <a href={it.url}>
                <ModIcon
                  url={it.iconUrl}
                  highlighted={highlightedMods.includes(i)}
                />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</li>

<style scoped>
  .card {
    background: var(--bg-2);
    padding: 1em;
    gap: 1em;
    border-radius: 0.5em;

    .description {
      font-size: 1em;
      margin-block: 1.5em;
    }

    h3 {
      span {
        margin-right: 0.6em;
      }

      [data-icon] {
        color: var(--text);
        align-items: end;
        margin-left: 0.4em;
        margin-bottom: -0.1em;

        transition: all 0.2s ease;

        &:hover {
          color: var(--accent);
        }
      }
    }

    .pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3em;
    }

    .icon {
      grid-area: icon;
    }

    display: grid;
    grid-template:
      "name icon"
      "pills icon"
      "details details"
      / 1fr 100px;

    .details {
      grid-area: details;

      i {
        display: block;
        margin-block: 1em;

        padding-top: 1em;
        border-top: 3px solid var(--bg-1);
      }

      .connections {
        list-style: none;
        padding: 0;

        display: grid;
        grid-template-columns: repeat(auto-fit, 50px);
        gap: 0.5em;

        li img {
          width: 50px;
        }
      }
    }
  }
</style>
