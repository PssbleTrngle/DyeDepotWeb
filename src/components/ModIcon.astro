---
export type Props = { url?: string; highlighted?: boolean };

const { url = "https://placehold.co/128", highlighted } = Astro.props;
---

<img src={url} class:list={{ highlighted }} />

<style scoped>
  img {
    aspect-ratio: 1 / 1;
    max-width: 100%;
    border-radius: 0.5em;
    border: 1px solid #fff2;

    transition: all 0.2s ease;

    &:hover {
      filter: brightness(1.2);
      border-color: #fff6;
    }

    &.highlighted {
      border-color: var(--accent);
      background: var(--accent);

      outline: var(--accent) 3px solid;
    }
  }
</style>
