---
import ModCard from "@/components/ModCard.astro";
import type { IncompatibleMod } from "@/mods";

export type Props = IncompatibleMod;

const { ticket, ...props } = Astro.props;
---

<ModCard {...props}>
  {
    ticket && (
      <a slot="details" href={ticket}>
        <button>⚠️ Linked Issue Ticket</button>
      </a>
    )
  }
</ModCard>

<style scoped>
  button {
    cursor: pointer;
    background: var(--bg-3);
    color: var(--text);
    padding: 0.6em;
    border-radius: 0.3em;
  }
</style>
