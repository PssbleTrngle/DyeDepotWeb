---
import Footer from "./components/Footer.astro";
import Nav from "./components/Nav.astro";

export type Props = { title?: string; class?: string };

const { title = "Dye Depot", ...props } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main {...props}>
      <slot />
    </main>
    <Footer />
  </body>

  <style is:global>
    :root {
      --accent: #e4a620;
      --text: #ddd;
      --bg-1: #2d2119;
      --bg-2: rgb(82, 55, 39);
      --bg-3: rgb(128, 84, 59);
    }

    html,
    body {
      margin: 0;
      padding: 0;

      background: var(--bg-1);
      color: var(--text);
      font-family: sans-serif;

      ::selection {
        background: var(--accent);
      }

      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }

    main {
      padding: 1em;
      flex: 1;
      margin: 0 auto;
    }

    input {
      background: var(--bg-2);
      color: white;
      padding: 0.5em;

      border-radius: 0.3em;
    }

    input,
    select,
    button {
      border: none;
      outline: 0 solid var(--accent);

      &:focus-visible {
        outline-width: 1px;
        box-shadow: 0 0 0 4px color-mix(var(--accent), transparent);
      }
    }

    h1 {
      text-align: center;
      margin-bottom: 1em;
    }

    a {
      color: var(--accent);
      text-decoration: none;

      transition: all 0.2s ease;

      &:hover {
        filter: brightness(1.1);
        text-decoration: underline;
      }
    }
  </style>
</html>
