---
import ModCard from "../components/ModCard.astro";
import { mods } from "../generated";
import Layout from "../layout.astro";
---

<Layout>
  <ul>
    {mods.map((it) => <ModCard {...it} />)}
  </ul>
</Layout>

<style scoped>
  ul {
    list-style: none;

    width: 800px;
    max-width: 90dvw;

    display: grid;
    gap: 1em;
  }
</style>
