---
import ModList from "../components/ModList.astro";
import Search from "../components/Search.astro";
import Layout from "../layout.astro";
import { searchMods } from "../search";

const initialSeach = Astro.url.searchParams.get("search") ?? "";

const mods = searchMods(initialSeach);
---

<Layout>
  <Search initial={initialSeach} />
  <ModList mods={mods} />
</Layout>
