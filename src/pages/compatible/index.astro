---
import ModList from "../../components/ModList.astro";
import Search from "../../components/Search.astro";
import { mods } from "../../generated";
import Layout from "../../layout.astro";
import { parseSearchQuery, searchMods } from "../../search";

const search = parseSearchQuery(Astro.url);
const matches = searchMods(mods, search);
---

<Layout>
  <Search initial={search} />
  <ModList mods={matches} connectionType="supportedBy" />
</Layout>
