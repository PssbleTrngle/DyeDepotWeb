---
import ModList from "../components/ModList.astro";
import Search from "../components/Search.astro";
import { compatibleMods } from "../generated";
import Layout from "../layout.astro";
import { parseSearchQuery, searchMods } from "../search";

const search = parseSearchQuery(Astro.url);
const matches = searchMods(compatibleMods, search);
---

<Layout title="Compatible">
  <h1>Compatible mods</h1>
  <Search initial={search} />
  <ModList mods={matches} />
</Layout>
