---
import ModList from "../components/ModList.astro";
import Search from "../components/Search.astro";
import { incompatibleMods } from "../generated";
import Layout from "../layout.astro";
import { parseSearchQuery, searchMods } from "../search";

const search = parseSearchQuery(Astro.url);
const matches = searchMods(incompatibleMods, search);
---

<Layout title="Incompatible">
  <h1>Known incompatibilities</h1>
  <Search initial={search} />
  <ModList mods={matches} />
</Layout>
