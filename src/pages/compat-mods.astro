---
import ModList from "../components/ModList.astro";
import Search from "../components/Search.astro";
import { compatMods } from "../generated";
import Layout from "../layout.astro";
import { parseSearchQuery, searchMods } from "../search";

const search = parseSearchQuery(Astro.url);
const matches = searchMods(compatMods, search);
---

<Layout title="Compat Mods">
  <h1>Mods that add support for other mods</h1>
  <Search initial={search} />
  <ModList mods={matches} />
</Layout>
